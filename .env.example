# Required: Anthropic API key used by planner/searcher/synthesizer/verifier
ANTHROPIC_API_KEY=sk-ant-...

# Required: Tavily API key used for web retrieval
TAVILY_API_KEY=tvly-...

# Required only for official GAIA evaluation after accepting the gated terms
HF_TOKEN=hf_...

# Optional: Override default model used in demo/eval scripts
# MODEL_NAME=claude-sonnet-4-6
